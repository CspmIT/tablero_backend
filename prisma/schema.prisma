// ============================================================================
//  Tablero de Mando Cooptech — Modelo de datos (Prisma + MySQL)
//  Plataforma single-tenant (uso interno de Cooptech).
//  Auth delegado al servicio de identidad central (multiproyecto): el backend
//  NO guarda usuarios ni contraseñas; valida el token y mapea `identitySub`.
//  Archivos/imágenes en MinIO; en la base se guarda solo la referencia (modelo Archivo).
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
//  ENUMS de dominio (espejan las constantes del tablero)
// ---------------------------------------------------------------------------

// Clasificación propia del tablero (NO es el `profile` de identidad).
enum TipoColaborador {
  manager
  gerencial
  collaborator
  externo
  tercerizado
}

enum Enfoque {
  ORGANIZACION    // "Organización"
  ELECTRONICA     // "Electrónica"
  DESARROLLO_WEB  // "Desarrollo web"
  COMERCIALIZACION // "Comercialización"
  OPERACION       // "Operación"
}

enum EstadoProyecto {
  activo
  pausado
  cerrado
}

enum KanbanColumna {
  backlog
  todo
  doing
  done
}

enum Prioridad {
  baja
  media
  alta
  urgente
}

// Etapas del embudo de CRM (incluye "perdido", que en el tablero es CRM_COLUMN_PERDIDO).
enum EtapaLead {
  contacto
  visita_agendada
  visita_realizada
  propuesta
  negociacion
  trial
  ganado
  perdido
  declinado
}

// Estado de un día en la grilla semanal de actividad.
enum EstadoGrilla {
  present
  home_office
  vacaciones
  franco
  franco_cumple
  feriado
  licencia
  viaje
}

// Cómo se calcula el avance de un objetivo.
enum ModoCalculoObjetivo {
  manual       // se carga a mano
  por_tags     // se deriva de tareas/proyectos etiquetados
  por_actividad // se deriva de actividades de CRM (Objetivo 8)
  por_leads     // avance por cantidad de leads y eventos del año (Objetivo 8)
  por_monto_ganado // avance por monto US$ de leads ganados del año vs meta (Objetivo 9)
}

// Tipos de actividad de CRM que alimentan el Objetivo 8 (visibilidad de marca).
enum TipoActividadCrm {
  visita
  videollamada
  evento
}

// ---------------------------------------------------------------------------
//  NÚCLEO: equipo
// ---------------------------------------------------------------------------

model Colaborador {
  id           Int          @id @default(autoincrement())
  // Vínculo con el servicio de identidad central. Null hasta el primer login mapeado.
  identitySub  String?         @unique
  // Credencial de login (estilo Reconecta `token_app`): UUID único por usuario,
  // asignado por el sistema central. NO se hashea. Se omite por defecto en TODAS
  // las lecturas (ver lib/prisma.js) para no filtrarla; el login la lee explícito.
  tokenApp     String?         @unique
  tipo         TipoColaborador @default(collaborator)
  nombre       String
  email        String?
  sector       String?
  // Clasificacion para el desglose de costos Cooptech: desarrollo (I+D) | comercial | organizacion.
  funcionCosto String          @default("desarrollo")
  iniciales    String?
  // Avatar como data-URI (recorte cuadrado 128x128), igual que el standalone.
  foto         String?         @db.Text
  haceGuardia  Boolean         @default(false)
  fechaIngreso DateTime?       @db.Date
  fechaSalida  DateTime?       @db.Date
  // Cumpleaños (día/mes; el año no importa para el tablero).
  cumpleDia    Int?
  cumpleMes    Int?
  activo       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  periodos           ColaboradorPeriodo[]
  tareasAsignadas    TareaResponsable[]
  leadsOwner         Lead[]               @relation("LeadOwner")
  proyectosOwner     Proyecto[]           @relation("ProyectoOwner")
  grillaEntradas     GrillaEntrada[]
  weeklyWips         WeeklyWip[]
  notasSemanales     NotaSemanal[]
  francosEspeciales  FrancoEspecial[]
  carryovers         Carryover[]
  actividadesCrm     CrmActividad[]

  @@index([activo])
}

// Períodos de actividad de un colaborador (para costos y grilla cuando entra/sale).
model ColaboradorPeriodo {
  id            Int      @id @default(autoincrement())
  colaboradorId Int
  desde         DateTime    @db.Date
  hasta         DateTime?   @db.Date // null = sigue activo
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId])
}

// ---------------------------------------------------------------------------
//  NÚCLEO: proyectos, tareas, etiquetas
// ---------------------------------------------------------------------------

model Proyecto {
  id        Int         @id @default(autoincrement())
  nombre    String
  enfoque   Enfoque?
  estado    EstadoProyecto @default(activo)
  cliente     String?
  descripcion String?       @db.Text
  ownerId     Int?
  owner       Colaborador?  @relation("ProyectoOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  fechaInicio DateTime?     @db.Date
  fechaFin    DateTime?     @db.Date
  inicioReal  DateTime?     @db.Date
  cierreReal  DateTime?     @db.Date
  objetivoId Int?
  objetivo   Objetivo?      @relation(fields: [objetivoId], references: [id], onDelete: SetNull)
  // Si el proyecto nació de un lead ganado (hand-off CRM -> Kanban).
  leadId    Int?
  lead      Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tareas Tarea[]

  @@index([leadId])
  @@index([objetivoId])
  @@index([ownerId])
}

model Tarea {
  id          Int        @id @default(autoincrement())
  proyectoId  Int?
  proyecto    Proyecto?     @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  titulo      String
  descripcion String?       @db.Text
  kanbanCol   KanbanColumna @default(backlog)
  prioridad   Prioridad     @default(media)
  pct         Int?          // 0..100; en columna 'done' se considera 100
  weight      Int           @default(1)
  fechaInicio DateTime?     @db.Date
  fechaFin    DateTime?     @db.Date
  startedAt   DateTime?     // inicio real (al pasar a doing)
  closedAt    DateTime?     // cierre real (al pasar a done)
  unidades    Json?         // subtareas por equipo en cards "por_equipo": [{ label, pct, done }]
  orden       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  responsables TareaResponsable[]
  tags         TareaTag[]

  @@index([proyectoId])
  @@index([kanbanCol])
}

// Catálogo de etiquetas (hoy `tags_registry`). Puente entre tareas y objetivos.
// Plantilla de proceso por producto: define las tareas que se generan al ganar un lead.
// etapas: [{ seq, tipo: 'unica'|'por_equipo', priority, owners: [colaboradorId], titulo, desc }]
model Plantilla {
  id          Int      @id @default(autoincrement())
  nombre      String
  producto    String   @unique
  unidadLabel String   @default("unidad")
  etapas      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        Int     @id @default(autoincrement())
  nombre    String     @unique
  categoria String?
  color     String?
  tareas    TareaTag[]
  objetivos ObjetivoTag[]
}

// Puente N:M tarea <-> colaborador (responsables).
model TareaResponsable {
  tareaId       Int
  colaboradorId Int
  tarea         Tarea       @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@id([tareaId, colaboradorId])
  @@index([colaboradorId])
}

// Puente N:M tarea <-> tag.
model TareaTag {
  tareaId Int
  tagId   Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tareaId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
//  NÚCLEO: objetivos
// ---------------------------------------------------------------------------

model Objetivo {
  id            Int              @id @default(autoincrement())
  codigo        String              // p.ej. "OE08"; único POR AÑO (ver @@unique abajo)
  titulo        String              @db.Text
  descripcion   String?             @db.Text
  indicador     String?             @db.Text
  meta          String?             @db.Text
  peso          Decimal?            @db.Decimal(6, 2)
  fechaEsperada DateTime?           @db.Date
  anio          Int                 @default(2026) // año de gestión del objetivo
  enfoque       Enfoque?
  calculo       ModoCalculoObjetivo @default(manual)
  avanceManual      Decimal?  @db.Decimal(5, 4)  // override manual 0..1; si es null/0 se deriva de proyectos
  asignadosIds      Json?     // ids de colaboradores asignados
  asignadosExternos Json?     // nombres de externos asignados
  asignadosTodos    Boolean   @default(false)
  depIt             Boolean   @default(false)    // depende de IT
  comentarios       String?   @db.Text            // notas de seguimiento (texto libre)
  metaNumerica      Decimal?  @db.Decimal(14, 2)  // meta en US$ para objetivos "por_monto_ganado"
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  proyectos        Proyecto[]
  tags             ObjetivoTag[]
  aportesActividad ObjetivoAporteActividad[]
  archivos         Archivo[]

  // El mismo código puede repetirse en distintos años de gestión (OE01 de 2025,
  // 2026 y 2027 son objetivos distintos); lo que no puede repetirse es el par.
  @@unique([codigo, anio])
}

model ObjetivoTag {
  objetivoId Int
  tagId      Int
  objetivo   Objetivo @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([objetivoId, tagId])
  @@index([tagId])
}

// Peso de cada tipo de actividad en un objetivo "por_actividad" (Objetivo 8).
// p.ej. visita/videollamada = 1%, evento = 10%.
model ObjetivoAporteActividad {
  id         Int           @id @default(autoincrement())
  objetivoId Int
  tipo       TipoActividadCrm
  aportePct  Decimal          @db.Decimal(6, 2)
  objetivo   Objetivo         @relation(fields: [objetivoId], references: [id], onDelete: Cascade)

  @@unique([objetivoId, tipo])
}

// ---------------------------------------------------------------------------
//  CRM
// ---------------------------------------------------------------------------

model Lead {
  id                 Int    @id @default(autoincrement())
  contactoNombre     String?
  cargo            String?           // cargo del contacto (Carola 05/08)
  organizacion       String
  telefono           String?
  email              String?
  ciudad             String?
  fechaPrimerContacto DateTime? @db.Date
  ownerId            Int?
  owner              Colaborador? @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  etapa              EtapaLead @default(contacto)

  // Valor comercial
  valorEstimadoUsd Decimal? @db.Decimal(14, 2)
  esEvento         Boolean  @default(false) // marca el lead como presentación en evento (Objetivo 8)
  valorOrigen      String   @default("manual") // "manual" | "presupuestador"
  montoFacturadoUsd Decimal? @db.Decimal(14, 2)
  // Ingresos (ola 3, 07/08): abono mensual genérico (Call Center, ESET, etc.;
  // para CoopCloud la vista cae a coopcloudCostoMensual si esto es null) y
  // fecha de ganado (se estampa sola al pasar a Ganado; editable p/ backfill).
  abonoMensualUsd  Decimal? @db.Decimal(14, 2)
  fechaGanado      DateTime? @db.Date
  cantidadEquipos  Int?
  equiposDetalle   String?  @db.Text

  // Seguimiento
  proximaAccion       String?
  proximaAccionFecha  DateTime? @db.Date
  motivoPerdido       String?   @db.Text
  notas               String?   @db.Text
  fuente              String?
  fuenteOtra          String?
  trialVence          DateTime? @db.Date
  trialNotas          String?   @db.Text
  presupuestoEnviadoFecha  DateTime? @db.Date
  presupuestoAprobadoFecha DateTime? @db.Date
  presupuestoLink     String?

  // Estados de los presupuestadores embebidos (cajas negras del iframe).
  // Las imágenes de +Agua NO van acá: viven en MinIO (modelo Archivo) y el JSON
  // referencia su id. Estos JSON guardan ítems, precios y configuración.
  presupuestoEstado     Json?
  presupuestoAguaEstado Json?
  coopcloudEstado       Json?
  coopcloudCostoMensual Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productos   LeadProducto[]
  actividades CrmActividad[]
  proyectos   Proyecto[]
  archivos    Archivo[]
  tareasSeguimiento LeadTarea[]

  // Ficha de Cliente asociada (se crea/completa al cargar facturación o al ganar).
  clienteId Int?
  clienteRef Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([etapa])
  @@index([ownerId])
  @@index([clienteId])
}

// Producto(s) de interés de un lead. String (no enum) para poder sumar productos
// nuevos sin migrar. Valores conocidos: +Agua, Reconecta, Centinela, CoopCloud,
// Cooptech (consultoría), Otro.
model LeadProducto {
  leadId   Int
  producto String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([leadId, producto])
}

// Catálogo de clientes/organizaciones.
// Datos de facturación (pedido Carola, 07/07): viven acá, NO en el lead. Se
// completan opcionalmente desde el lead (tilde) y son requeridos en el hand-off
// a "Ganado". Todos opcionales a nivel de base; la obligatoriedad la impone la UI.
model Cliente {
  id          Int   @id @default(autoincrement())
  nombre      String   @unique
  tipoCliente String?  @default("Cooperativa")
  razonSocial String?
  cuit        String?
  direccion   String?
  localidad   String?
  ciudad      String?
  celular     String?
  emailFacturacion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]
}

// Actividades de CRM que alimentan el Objetivo 8 (visibilidad de marca).
// PENDIENTE de definir con Leonardo: si la actividad se ata a un lead o va suelta,
// y cómo se registran videollamadas/visitas. Por eso leadId es opcional.
model CrmActividad {
  id            Int           @id @default(autoincrement())
  leadId        Int?
  lead          Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  colaboradorId Int?
  colaborador   Colaborador?     @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)
  tipo          TipoActividadCrm
  fecha         DateTime         @db.Date
  notas         String?          @db.Text
  cancelada     Boolean          @default(false) // reuniones canceladas no cuentan en métricas
  createdAt     DateTime         @default(now())

  @@index([leadId])
  @@index([tipo, fecha])
}

// ---------------------------------------------------------------------------
//  ARCHIVOS (MinIO): imágenes de +Agua, PDFs, etc.
//  El binario vive en MinIO; acá solo el registro y la referencia.
// ---------------------------------------------------------------------------

model Archivo {
  id        Int   @id @default(autoincrement())
  key       String   @unique // ruta/objeto en MinIO
  url       String?           // URL pública o firmada (puede regenerarse)
  nombre    String
  mime      String?
  tamano    Int?
  // Metadata de fotos de +Agua
  gpsLat    Float?
  gpsLng    Float?
  esBoceto  Boolean  @default(false)
  // Contexto al que pertenece
  leadId    Int?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  objetivoId Int?
  objetivo  Objetivo? @relation(fields: [objetivoId], references: [id], onDelete: SetNull)
  contexto  String?  // p.ej. "agua_foto", "pdf_presupuesto", "avatar", "objetivo_foto"
  createdAt DateTime @default(now())
  postsMarketing MarketingPostArchivo[] // vínculos del calendario de Marketing (22/08)

  @@index([leadId])
  @@index([objetivoId])
}

// ---------------------------------------------------------------------------
//  OPERACIÓN: grilla, guardias, francos, feriados, vacaciones
// ---------------------------------------------------------------------------

// Una entrada por colaborador y día. `items` guarda las tareas del día como JSON:
// [{ text, wip, tags:[] }]. El estado del día sale de EstadoGrilla.
model GrillaEntrada {
  id            Int       @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador  @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  fecha         DateTime     @db.Date
  estado        EstadoGrilla @default(present)
  entryTime     String?      // hora de ingreso (HH:MM), solo si estado = present
  viajeLabel    String?      // destino, solo si estado = viaje
  items         Json?        // [{ text, wip, tags }]
  horasExtra    Json?        // { ingreso, salida, horas } | null
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([colaboradorId, fecha])
  @@index([fecha])
}

// Foco principal de la semana (texto libre) por colaborador y semana ISO.
model WeeklyWip {
  id            Int      @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  anio          Int
  semanaIso     Int
  texto         String   @db.Text

  @@unique([colaboradorId, anio, semanaIso])
}

// Rotación de guardias: una fila por semana (anio + week), con las asignaciones embebidas.
// asignaciones: [{ id: colaboradorId, vacation?: boolean, count?: number }]
// Mis notas (ola 3, 07/08): texto libre semanal por persona, visible para
// todos, editable SOLO por su autor (lo impone la ruta: autor = token).
// Misma clave de semana que WeeklyWip: año calendario del lunes + semana ISO.
model NotaSemanal {
  id            Int      @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  anio          Int
  semanaIso     Int
  texto         String   @db.Text
  updatedAt     DateTime @updatedAt

  @@unique([colaboradorId, anio, semanaIso])
}

model GuardiaSemana {
  id           Int    @id @default(autoincrement())
  anio         Int
  week         Int
  range        String   // "DD/MM al DD/MM" (a partir del lunes de inicio)
  asignaciones Json

  @@unique([anio, week])
}

// Francos/licencias puntuales fuera de la grilla regular.
model FrancoEspecial {
  id            Int      @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  fecha         DateTime    @db.Date
  tipo          String?     // p.ej. "franco", "licencia"
  motivo        String?

  @@index([colaboradorId])
  @@index([fecha])
}

model Feriado {
  id     Int   @id @default(autoincrement())
  fecha  DateTime @unique @db.Date
  nombre String
}

// Vacaciones acumuladas / arrastre por colaborador y año.
model Carryover {
  id            Int      @id @default(autoincrement())
  colaboradorId Int
  anio          Int
  dias          Decimal     @db.Decimal(6, 2)
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([colaboradorId, anio])
}

// ---------------------------------------------------------------------------
//  COSTOS (metodología CPN Deusebio)
//  Solo se guardan los insumos por mes; CMT/CMP/NAP/NAR se calculan en runtime.
// ---------------------------------------------------------------------------

model CostoMensual {
  id              Int   @id @default(autoincrement())
  mes             String   @unique // "YYYY-MM"
  costoLaboral    Decimal? @db.Decimal(14, 2) // ARS
  cotizacionDolar Decimal? @db.Decimal(14, 4)
  // Distribución de horas por colaborador/semana entre unidades de negocio (CPN).
  // { [colaboradorId]: { weeks: [ { unidades: { adm, energia, ... } } ] } }
  asignaciones    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
//  NOTA: el módulo de Materiales/inventario queda fuera de este esquema inicial
//  (todavía no existe en el tablero). Se agrega cuando se diseñe, en su propia ola.
// ---------------------------------------------------------------------------

// Configuración editable desde la app (p.ej. clave de API del asistente).
// El valor se guarda CIFRADO (AES-256-GCM con clave derivada de AUTH_JWT_SECRET).
model Configuracion {
  clave     String   @id
  valor     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Tareas de seguimiento de un lead (pedido Carola 14/07, estilo Kommo):
// pendientes con fecha límite que se completan con un resultado opcional.
model LeadTarea {
  id           Int       @id @default(autoincrement())
  leadId       Int
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  texto        String    @db.Text
  fechaLimite  DateTime? @db.Date
  done         Boolean   @default(false)
  resultado    String?   @db.Text
  creadorId    Int?
  completadoAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([leadId, done])
}

// "Mis Deseos": pedidos de desarrollo/mejora de cualquier colaborador de la
// cooperativa. Formaliza el embudo de demanda: solicitud → revisión (con
// Jorge) → respuesta → si se aprueba, pasa como card al backlog del kanban.
enum DeseoEstado {
  borrador
  enviado
  en_revision
  aprobado
  rechazado
  requiere_cambios
}

// Calendario de publicaciones de Marketing (ola 3, 21/08): el espacio de
// trabajo del mes que Booster lleva en COOPTECH.xlsx (DÍA/FORMATO/CONTENIDO/
// canal/copys), como calendario en vez de tabla. canal y formato son STRING
// (lección enum 06/08: los catálogos que pueden crecer no se cierran en la base).
model MarketingPost {
  id          Int      @id @default(autoincrement())
  mes         String   // 'YYYY-MM' (mismo mes lógico que las rutas plan/...)
  dia         Int      // 1..31
  canal       String   // feed | historia | linkedin | mailing (hoy)
  formato     String?  // Historia | Carrusel | Reel | Placa | Mailing... (libre)
  titulo      String
  nota        String?  @db.Text // copy, pie de foto, comentario
  creadoPorId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivos    MarketingPostArchivo[]

  @@index([mes])
}

// Vínculo publicación ↔ archivo subido (22/08, pedido de Leonardo): al planificar
// se eligen las piezas del contenido, y el archivo vinculado muestra el sello
// «usado» (reutilizable — la meta es que no quede material sin usar). Cascade en
// las dos puntas: borrar el post o el archivo limpia el vínculo solo.
model MarketingPostArchivo {
  id        Int           @id @default(autoincrement())
  postId    Int
  post      MarketingPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  archivoId Int
  archivo   Archivo       @relation(fields: [archivoId], references: [id], onDelete: Cascade)

  @@unique([postId, archivoId])
  @@index([archivoId])
}

model Deseo {
  id             Int         @id @default(autoincrement())
  titulo         String
  descripcion    String      @db.Text
  solicitanteId  Int
  fechaNecesidad DateTime?   @db.Date // estimada por el solicitante
  estado         DeseoEstado @default(borrador)
  respuesta      String?     @db.Text // obligatoria al rechazar
  respondidoPorId Int?
  respondidoAt   DateTime?
  tareaId        Int?        // card creada en el kanban al aprobar
  createdAt      DateTime    @default(now()) // fecha de solicitud
  updatedAt      DateTime    @updatedAt

  @@index([solicitanteId, estado])
}

// Inbox → Tickets (20/08): mini sistema de tickets espejo de la Mesa de ayuda
// de la cooperativa. Origen: manual (el equipo digitaliza), whatsapp (guardia)
// o mesa_ayuda (sync por API cuando Guillermo la exponga — externalId).
// tipo/prioridad/area quedan como STRING (los valores los define el sistema
// de la Mesa de ayuda — lección del enum 06/08); estado sí es enum cerrado.
// Clasificación OV propia (ovTipo/ovCausa/categoriaFalla) + vínculo opcional
// a un ítem de grilla (antidoble-conteo en Métricas OV: manda el ticket, el
// ítem aporta las horas). Diseño: claude/Inbox_Tickets_ReporteOV_diseno_20_08.md
enum TicketEstado {
  abierto
  en_proceso
  resuelto
  cerrado
}

enum TicketOrigen {
  manual
  whatsapp
  mesa_ayuda
}

model Ticket {
  id             Int          @id @default(autoincrement())
  sector         String?      // "TU SECTOR" del solicitante (texto libre)
  titulo         String
  tipo           String       @default("Incidente")
  prioridad      String       @default("Media")
  area           String       @default("Desarrollo")
  copiarA        String?      @db.Text
  descripcion    String       @db.Text
  estado         TicketEstado @default(abierto)
  origen         TicketOrigen @default(manual)
  externalId     String?      @unique // id en la Mesa de ayuda (sync idempotente)
  solicitante    String?      // cliente interno (puede no ser usuario nuestro)
  creadoPorId    Int?         // colaborador que lo digitalizó (null si vino por API)
  asignadoAId    Int?
  ovTipo         String?      // incidente | solicitud
  ovCausa        String?      // catálogo de causas OV
  categoriaFalla String?      // a | b | c (mandato M1, solo incidentes)
  grillaEntradaId Int?        // vínculo al ítem de grilla (entrada + itemId)
  grillaItemId   String?
  ocurridoAt     DateTime?    // fecha real del reclamo (WhatsApp de días atrás)
  resueltoAt     DateTime?
  cerradoAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([estado, area])
  @@index([createdAt])
}

model TicketMensaje {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  autorId    Int?     // null = importado (autor externo en texto)
  autor      String?
  texto      String   @db.Text
  externalId String?  @unique
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

// Ola de reuniones (16/07): ciclo de vida completo (crear → reprogramar →
// cancelar) para reuniones con clientes (CRM) e internas (Mi mes), con el
// evento de Outlook sincronizado (Graph) y los ítems de grilla marcados.
enum ReunionModalidad {
  virtual
  presencial
}

enum ReunionEstado {
  activa
  cancelada
}

model Reunion {
  id               Int               @id @default(autoincrement())
  tipo             String            // 'cliente' | 'interna'
  titulo           String
  fecha            DateTime          @db.Date
  horaInicio       String
  horaFin          String
  modalidad        ReunionModalidad  @default(virtual)
  lugar            String?           // sala (presencial)
  organizadorId    Int?
  leadId           Int?
  crmActividadId   Int?
  colaboradoresIds Json              // [int] involucrados (incluye organizador)
  emailsExternos   Json?             // [string] invitados por mail (Carola 04/08)
  tags             Json?             // etiquetas del ítem de grilla (prueba estrella)
  graphEventId     String?           // permite PATCH/DELETE del evento Outlook
  casilla          String?           // buzón donde vive el evento
  joinUrl          String?           @db.Text
  estado           ReunionEstado     @default(activa)
  respuestas       Json?             // { [colabId]: 'aceptada'|'rechazada'|'provisional' }
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([fecha, estado])
}

// Suscripciones Web Push por colaborador (notificaciones con la app cerrada).
model PushSuscripcion {
  id            Int      @id @default(autoincrement())
  colaboradorId Int
  endpoint      String   @db.VarChar(500)
  datos         Json     // { keys: { p256dh, auth } } y demás campos de la suscripción
  createdAt     DateTime @default(now())

  @@unique([endpoint])
  @@index([colaboradorId])
}
